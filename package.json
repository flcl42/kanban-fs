{
  "name": "kanban-vsix",
  "displayName": "ai-kanban",
  "description": "AI-ready Kanban boards backed by folders, Markdown files, and an optional Codex runner.",
  "version": "1.0.20",
  "license": "MIT",
  "publisher": "flcl42",
  "repository": "https://github.com/flcl42/kanban-fs",
  "keywords": [
    "ai",
    "kanban",
    "tasks",
    "markdown",
    "codex",
    "agent",
    "workflow",
    "project-management"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:markdown",
    "onLanguage:kanban"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "icon.png",
  "main": "./out/extension.js",
  "files": [
    "out/extension.js",
    "docs/kanban.png",
    "codex_runner.csx",
    "readme_codex_runner.md",
    "LICENSE",
    "icon.png",
    "language-configuration.json",
    "syntaxes/kanban.tmLanguage.json"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kanban",
        "aliases": [
          "Kanban",
          ".kanban"
        ],
        "extensions": [
          ".kanban"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "kanban",
        "scopeName": "source.kanban",
        "path": "./syntaxes/kanban.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "kanban.createEmptyBoard",
        "title": "Create Empty Board",
        "category": "AI Kanban"
      },
      {
        "command": "kanban.createBoardWithColumns",
        "title": "Create Board with Columns",
        "category": "AI Kanban"
      },
      {
        "command": "kanban.createBoardWithRunner",
        "title": "Create Board with Initialized Runner",
        "category": "AI Kanban"
      },
      {
        "command": "kanban.resumeAgent",
        "title": "Connect Agent",
        "category": "AI Kanban"
      },
      {
        "command": "kanban.openPath",
        "title": "Open Path",
        "category": "AI Kanban"
      },
      {
        "command": "kanban.openCode",
        "title": "Open Path in VS Code",
        "category": "AI Kanban"
      },
      {
        "command": "kanban.openUrl",
        "title": "Open URL",
        "category": "AI Kanban"
      }
    ],
    "customEditors": [
      {
        "viewType": "kanban.board",
        "displayName": "AI Kanban Board",
        "selector": [
          {
            "filenamePattern": "*.kanban"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "AI Kanban",
      "properties": {
        "kanban.detailsPaneWidth": {
          "type": "number",
          "default": 360,
          "minimum": 280,
          "maximum": 720,
          "scope": "application",
          "description": "Width in pixels of the Kanban details pane."
        },
        "kanban.runnerPanel.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Show a Kanban board warning panel when no runner status endpoint is detected for the board."
        },
        "kanban.runner.command": {
          "type": "string",
          "default": "dotnet",
          "scope": "application",
          "description": "Command used to start the Kanban runner from the warning panel."
        },
        "kanban.runner.args": {
          "type": "array",
          "default": [
            "script",
            "${runnerScript}",
            "--",
            "--root",
            "${runnerRoot}"
          ],
          "items": {
            "type": "string"
          },
          "scope": "application",
          "description": "Arguments used to start the Kanban runner. Supports ${runnerScript}, ${runnerRoot}, ${kanbanDir}, and ${workspaceFolder}."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:release",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=out/extension.js",
    "build:release": "npm run compile && npm run bundle",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package:vsix": "npm test && vsce package",
    "publish:marketplace": "npm test && vsce publish",
    "test": "npm run compile && npm run test:webview && npm run test:task-links && npm run test:board-config && npm run test:new-card",
    "test:board-config": "node scripts/test-board-config.js",
    "test:new-card": "node scripts/test-new-card.js",
    "test:webview": "node scripts/smoke-webview.js",
    "test:task-links": "node scripts/test-task-links.js"
  },
  "devDependencies": {
    "@types/markdown-it": "^13.0.7",
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.4",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "yaml": "^2.8.2"
  }
}
