{
  "name": "kanban-vsix",
  "displayName": "Kanban-fs",
  "description": "Kanban board backed by folders and markdown files.",
  "version": "1.0.6",
  "license": "MIT",
  "publisher": "flcl42",
  "repository": "https://github.com/flcl42/kanban-fs",
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:kanban"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "icon.png",
  "main": "./out/extension.js",
  "files": [
    "out/extension.js",
    "LICENSE",
    "icon.png",
    "language-configuration.json",
    "syntaxes/kanban.tmLanguage.json"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kanban",
        "aliases": [
          "Kanban",
          ".kanban"
        ],
        "extensions": [
          ".kanban"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "kanban",
        "scopeName": "source.kanban",
        "path": "./syntaxes/kanban.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "kanban.resumeAgent",
        "title": "Kanban: Connect Agent"
      },
      {
        "command": "kanban.openPath",
        "title": "Kanban: Open Path"
      }
    ],
    "customEditors": [
      {
        "viewType": "kanban.board",
        "displayName": "Kanban Board",
        "selector": [
          {
            "filenamePattern": "*.kanban"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build:release",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=out/extension.js",
    "build:release": "npm run compile && npm run bundle",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package:vsix": "npm test && vsce package",
    "publish:marketplace": "npm test && vsce publish",
    "test": "npm run compile && npm run test:webview && npm run test:task-links && npm run test:board-config && npm run test:new-card",
    "test:board-config": "node scripts/test-board-config.js",
    "test:new-card": "node scripts/test-new-card.js",
    "test:webview": "node scripts/smoke-webview.js",
    "test:task-links": "node scripts/test-task-links.js"
  },
  "devDependencies": {
    "@types/markdown-it": "^13.0.7",
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.4",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "yaml": "^2.8.2"
  }
}
