{
  "name": "kanban-vsix",
  "displayName": "ai-kanban",
  "description": "AI-ready Kanban boards backed by folders, Markdown files, and an optional agent runner.",
  "version": "1.0.44",
  "license": "MIT",
  "publisher": "flcl42",
  "repository": "https://github.com/flcl42/kanban-fs",
  "keywords": [
    "ai",
    "kanban",
    "tasks",
    "markdown",
    "codex",
    "opencode",
    "devin",
    "agent",
    "workflow",
    "project-management"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:markdown",
    "onLanguage:kanban"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "icon.png",
  "main": "./out/extension.js",
  "files": [
    "out/extension.js",
    "docs/kanban.png",
    "runner.py",
    "readme_runner.md",
    "LICENSE",
    "icon.png",
    "language-configuration.json",
    "syntaxes/kanban.tmLanguage.json"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kanban",
        "aliases": [
          "Kanban",
          ".kanban"
        ],
        "extensions": [
          ".kanban"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "kanban",
        "scopeName": "source.kanban",
        "path": "./syntaxes/kanban.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "kanban.createEmptyBoard",
        "title": "Create Empty Board",
        "category": "AI Kanban"
      },
      {
        "command": "kanban.createBoardWithColumns",
        "title": "Create Board with Columns",
        "category": "AI Kanban"
      },
      {
        "command": "kanban.createBoardWithRunner",
        "title": "Create Board with Initialized Runner",
        "category": "AI Kanban"
      },
      {
        "command": "kanban.initializeRunner",
        "title": "Initialize Runner",
        "category": "AI Kanban"
      },
      {
        "command": "kanban.replaceRunner",
        "title": "Replace Runner with Bundled Version",
        "category": "AI Kanban"
      },
      {
        "command": "kanban.initializeTemplate",
        "title": "Initialize Template",
        "category": "AI Kanban"
      },
      {
        "command": "kanban.resumeAgent",
        "title": "Connect Agent",
        "category": "AI Kanban"
      },
      {
        "command": "kanban.openPath",
        "title": "Open Path in Terminal",
        "category": "AI Kanban"
      },
      {
        "command": "kanban.openCode",
        "title": "Open Path in VS Code",
        "category": "AI Kanban"
      },
      {
        "command": "kanban.openUrl",
        "title": "Open URL",
        "category": "AI Kanban"
      },
      {
        "command": "kanban.openLocalPath",
        "title": "Open Path",
        "category": "AI Kanban"
      }
    ],
    "customEditors": [
      {
        "viewType": "kanban.board",
        "displayName": "AI Kanban Board",
        "selector": [
          {
            "filenamePattern": "*.kanban"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "AI Kanban",
      "properties": {
        "kanban.detailsPaneWidth": {
          "type": "number",
          "default": 360,
          "minimum": 280,
          "maximum": 720,
          "scope": "resource",
          "description": "Width in pixels of the Kanban details pane."
        },
        "kanban.detailsPane.visible": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show the Kanban details pane by default."
        },
        "kanban.runnerPanel.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Show a Kanban board warning panel when no runner status endpoint is detected for the board."
        },
        "kanban.runner.command": {
          "type": "string",
          "default": "python",
          "scope": "application",
          "description": "Command used to start the Kanban runner from the warning panel."
        },
        "kanban.runner.args": {
          "type": "array",
          "default": [
            "${runnerScript}",
            "--root",
            "${runnerRoot}",
            "--default-agent",
            "${defaultAgent}",
            "--codex-executable",
            "${codexExecutable}",
            "--claude-executable",
            "${claudeExecutable}",
            "--kimi-executable",
            "${kimiExecutable}",
            "--deepseek-executable",
            "${deepseekExecutable}",
            "--opencode-executable",
            "${opencodeExecutable}",
            "--devin-executable",
            "${devinExecutable}"
          ],
          "items": {
            "type": "string"
          },
          "scope": "application",
          "description": "Arguments used to start the Kanban runner. Supports ${runnerScript}, ${runnerRoot}, ${kanbanDir}, ${workspaceFolder}, ${defaultAgent}, ${codexExecutable}, ${claudeExecutable}, ${kimiExecutable}, ${deepseekExecutable}, ${opencodeExecutable}, and ${devinExecutable}."
        },
        "kanban.defaultAgent": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "claude",
            "codex",
            "opencode",
            "oc",
            "kimi",
            "deepseek",
            "devin",
            "manual"
          ],
          "scope": "resource",
          "description": "Default agent for runner tasks. Use auto to auto-detect Claude first, then Codex, then opencode, then Kimi, then DeepSeek, then Devin. Use manual to keep unassigned cards user-managed by default. Task tags such as claude, codex, opencode, oc, kimi, deepseek, ds, deepcode, devin, agent:claude, agent:codex, agent:opencode, agent:oc, agent:kimi, agent:deepseek, agent:devin, manual, or human override this per card."
        },
        "kanban.defaultModels": {
          "type": "object",
          "default": {
            "codex": "",
            "claude": "",
            "kimi": "",
            "deepseek": "",
            "opencode": "",
            "devin": ""
          },
          "properties": {
            "codex": {
              "type": "string",
              "description": "Default Codex Model: value for new runner sessions, for example codex/gpt-6.1-sol/ultra or gpt-6.1-sol/ultra."
            },
            "claude": {
              "type": "string",
              "description": "Default Claude Model: value for new runner sessions, for example claude/sonnet/max or sonnet/max."
            },
            "kimi": {
              "type": "string",
              "description": "Default Kimi Model: value for new runner sessions, for example kimi/k2 or k2."
            },
            "deepseek": {
              "type": "string",
              "description": "Default DeepSeek Model: value for new runner sessions, for example deepseek/deepseek-v4-pro/max or deepseek-v4-pro/max."
            },
            "opencode": {
              "type": "string",
              "description": "Default opencode Model: value for new runner sessions, for example opencode/opencode-go/kimi-k3 or opencode-go/kimi-k3."
            },
            "devin": {
              "type": "string",
              "description": "Default Devin Model: value for new runner sessions, for example devin/swe-2/max or swe-2/max."
            }
          },
          "additionalProperties": {
            "type": "string"
          },
          "scope": "resource",
          "description": "Default Model: values used by the runner when a new task has no Model property. Board .kanban defaultModels override this per board, and task Model properties override both."
        },
        "kanban.modelCompletions": {
          "type": "array",
          "default": [
            "codex/gpt-6.1-sol/ultra",
            "codex/gpt-6.1-sol/max",
            "codex/gpt-6.1-sol/xhigh",
            "codex/gpt-6.1-sol/high",
            "codex/gpt-6.1-sol/medium",
            "codex/gpt-6.1-sol/low",
            "codex/gpt-6-astra/ultra",
            "codex/gpt-6-astra/max",
            "codex/gpt-6-astra/xhigh",
            "codex/gpt-6-astra/high",
            "codex/gpt-6-astra/medium",
            "codex/gpt-6-astra/low",
            "codex/gpt-6-sol/ultra",
            "codex/gpt-6-sol/max",
            "codex/gpt-6-sol/xhigh",
            "codex/gpt-6-sol/high",
            "codex/gpt-6-sol/medium",
            "codex/gpt-6-sol/low",
            "codex/gpt-6-luna/max",
            "codex/gpt-6-luna/xhigh",
            "codex/gpt-6-luna/high",
            "codex/gpt-6-luna/medium",
            "codex/gpt-6-luna/low",
            "codex/gpt-reserve/max",
            "codex/gpt-reserve/xhigh",
            "codex/gpt-reserve/high",
            "codex/gpt-reserve/medium",
            "codex/gpt-reserve/low",
            "codex/gpt-5.6-sol/ultra",
            "codex/gpt-5.6-sol/max",
            "codex/gpt-5.6-sol/xhigh",
            "codex/gpt-5.6-sol/high",
            "codex/gpt-5.6-sol/medium",
            "codex/gpt-5.6-sol/low",
            "codex/gpt-5.6-terra/ultra",
            "codex/gpt-5.6-terra/max",
            "codex/gpt-5.6-terra/xhigh",
            "codex/gpt-5.6-terra/high",
            "codex/gpt-5.6-terra/medium",
            "codex/gpt-5.6-terra/low",
            "codex/gpt-5.6-luna/ultra",
            "codex/gpt-5.6-luna/max",
            "codex/gpt-5.6-luna/xhigh",
            "codex/gpt-5.6-luna/high",
            "codex/gpt-5.6-luna/medium",
            "codex/gpt-5.6-luna/low",
            "codex/sol/ultra",
            "claude/sonnet/ultra",
            "claude/sonnet/max",
            "claude/sonnet/xhigh",
            "claude/sonnet/high",
            "claude/sonnet/medium",
            "claude/sonnet/low",
            "claude/opus/ultra",
            "claude/opus/max",
            "claude/opus/xhigh",
            "claude/opus/high",
            "claude/opus/medium",
            "claude/opus/low",
            "claude/fable/ultra",
            "claude/fable/max",
            "claude/fable/xhigh",
            "claude/fable/high",
            "claude/fable/medium",
            "claude/fable/low",
            "claude/haiku/ultra",
            "claude/haiku/max",
            "claude/haiku/xhigh",
            "claude/haiku/high",
            "claude/haiku/medium",
            "claude/haiku/low",
            "kimi/k2",
            "opencode/opencode-go/cat-jam-free",
            "opencode/opencode-go/claude-haiku-5-5",
            "opencode/opencode-go/deepseek-v4-pro",
            "opencode/opencode-go/deepseek-v4.1-flash",
            "opencode/opencode-go/gemini-4-argon-contributor",
            "opencode/opencode-go/glm-5.2",
            "opencode/opencode-go/glm-5.3",
            "opencode/opencode-go/glm-5.3-flash",
            "opencode/opencode-go/gpt-5.6-luna",
            "opencode/opencode-go/gpt-6-luna",
            "opencode/opencode-go/grok-4.6",
            "opencode/opencode-go/grok-4.7",
            "opencode/opencode-go/hy3",
            "opencode/opencode-go/hy4-preview",
            "opencode/opencode-go/kimi-k2.7-code",
            "opencode/opencode-go/kimi-k3",
            "opencode/opencode-go/longcat-2.0",
            "opencode/opencode-go/longcat-2.5-preview-free",
            "opencode/opencode-go/mimo-v2.5",
            "opencode/opencode-go/mimo-v2.5-pro",
            "opencode/opencode-go/mimo-v2.6-flash",
            "opencode/opencode-go/mimo-v2.6-pro",
            "opencode/opencode-go/minimax-m2.7",
            "opencode/opencode-go/minimax-m3",
            "opencode/opencode-go/muse-spark-1.2-contributor",
            "opencode/opencode-go/muse-spark-1.3-contributor",
            "opencode/opencode-go/qwen3.7-plus",
            "opencode/opencode-go/qwen3.8-flash",
            "opencode/opencode-go/qwen3.8-max",
            "opencode/opencode-go/space-bunny",
            "opencode/opencode-go/step-5-preview-free",
            "opencode/opencode/big-pickle",
            "opencode/opencode/cat-jam-free",
            "opencode/opencode/longcat-2.5-preview-free",
            "opencode/opencode/mimo-v2.6-flash-free",
            "opencode/opencode/muse-spark-1.3-contributor-free",
            "opencode/opencode/nemotron-3-ultra-free",
            "opencode/opencode/nemotron-3.5-lightning-free",
            "opencode/opencode/space-bunny-free",
            "opencode/opencode/step-5-preview-free",
            "opencode/deepseek/deepseek-v4-pro/max",
            "opencode/deepseek/deepseek-v4-flash/high",
            "deepseek/deepseek-v4-pro/max",
            "deepseek/deepseek-v4-pro/high",
            "deepseek/deepseek-v4-flash/max",
            "deepseek/deepseek-v4-flash/high",
            "devin/swe-2/max",
            "devin/swe-2/high",
            "devin/swe-2/medium",
            "devin/swe",
            "devin/swe-1-7-lightning",
            "devin/opus",
            "devin/sonnet",
            "devin/gpt",
            "devin/codex",
            "devin/gemini",
            "devin/kimi",
            "devin/deepseek",
            "devin/glm"
          ],
          "items": {
            "type": "string"
          },
          "scope": "resource",
          "description": "Model: values suggested in Markdown task files. Supports values such as agent/model and agent/model/effort; custom typed values are still accepted."
        },
        "kanban.codexExecutable": {
          "type": "string",
          "default": "codex",
          "scope": "application",
          "description": "Codex executable used by the Kanban runner and Codex resume-agent terminals."
        },
        "kanban.claudeExecutable": {
          "type": "string",
          "default": "claude",
          "scope": "application",
          "description": "Claude Code executable used by the Kanban runner and Claude resume-agent terminals."
        },
        "kanban.kimiExecutable": {
          "type": "string",
          "default": "kimi",
          "scope": "application",
          "description": "Kimi CLI executable used by the Kanban runner and Kimi resume-agent terminals."
        },
        "kanban.deepseekExecutable": {
          "type": "string",
          "default": "deepcode",
          "scope": "application",
          "description": "Deep Code executable used by the Kanban runner and DeepSeek resume-agent terminals."
        },
        "kanban.opencodeExecutable": {
          "type": "string",
          "default": "opencode",
          "scope": "application",
          "description": "opencode executable used by the Kanban runner and opencode resume-agent terminals. The agent alias oc is accepted in task tags and default-agent settings."
        },
        "kanban.devinExecutable": {
          "type": "string",
          "default": "devin",
          "scope": "application",
          "description": "Devin CLI executable used by the Kanban runner and Devin resume-agent terminals."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:release",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=out/extension.js",
    "build:release": "npm run compile && npm run bundle",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package:vsix": "npm test && vsce package",
    "publish:marketplace": "npm test && vsce publish",
    "test": "npm run compile && npm run test:runner && npm run test:webview && npm run test:task-links && npm run test:model-completions && npm run test:tag-completions && npm run test:file-names && npm run test:board-config && npm run test:new-card && npm run test:fast-move-path",
    "test:runner": "python -m py_compile runner.py && python scripts/test-runner-metadata.py",
    "test:board-config": "node scripts/test-board-config.js",
    "test:new-card": "node scripts/test-new-card.js",
    "test:webview": "node scripts/smoke-webview.js",
    "test:task-links": "node scripts/test-task-links.js",
    "test:model-completions": "node scripts/test-model-completions.js",
    "test:tag-completions": "node scripts/test-tag-completions.js",
    "test:file-names": "node scripts/test-file-names.js",
    "test:fast-move-path": "node scripts/test-fast-move-path.js"
  },
  "devDependencies": {
    "@types/markdown-it": "^13.0.7",
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.4",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "yaml": "^2.8.2"
  }
}
